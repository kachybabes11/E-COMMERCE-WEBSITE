<%
  const allMessages = Array.isArray(flashMessages) ? flashMessages : [];
  const toastMessages = allMessages.filter((message) => message.type !== "birthday");
  const birthdayMessage = allMessages.find((message) => message.type === "birthday");
%>

<div class="toast-container">
  <% toastMessages.forEach((message) => { %>
    <div class="toast toast-<%= message.type %>"><%= message.text %></div>
  <% }) %>
</div>

<% if (birthdayMessage) { %>
  <div class="birthday-modal" id="birthdayModal" role="dialog" aria-modal="true" aria-labelledby="birthdayTitle">
    <div class="birthday-modal-card">
      <button type="button" class="birthday-close" id="birthdayClose" aria-label="Close birthday message">×</button>
      <h2 id="birthdayTitle"><%= birthdayMessage.title || "Happy Birthday" %></h2>
      <p><%= birthdayMessage.text %></p>
    </div>
  </div>
<% } %>

<script>
  window.addEventListener("DOMContentLoaded", function () {
    var toasts = document.querySelectorAll(".toast-container .toast");
    toasts.forEach(function (toast) {
      window.setTimeout(function () {
        toast.classList.add("fade");
        window.setTimeout(function () {
          toast.remove();
        }, 280);
      }, 5000);
    });

    var birthdayModal = document.getElementById("birthdayModal");
    var birthdayClose = document.getElementById("birthdayClose");
    if (birthdayModal) {
      var closeModal = function () {
        birthdayModal.classList.add("closing");
        window.setTimeout(function () {
          birthdayModal.remove();
        }, 220);
      };

      if (birthdayClose) {
        birthdayClose.addEventListener("click", closeModal);
      }

      birthdayModal.addEventListener("click", function (event) {
        if (event.target === birthdayModal) {
          closeModal();
        }
      });
    }
  });
</script>

<style>
.toast-container {
  position: fixed;
  top: 1rem;
  right: 1rem;
  z-index: 2000;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.toast {
  padding: 1rem 1.25rem;
  border-radius: 16px;
  color: #fff;
  box-shadow: 0 20px 50px rgba(0,0,0,0.12);
  animation: slideIn 0.35s ease;
  transition: opacity 0.28s ease, transform 0.28s ease;
}
.toast.fade {
  opacity: 0;
  transform: translateX(12px);
}
.toast-success { background: #1f7f4c; }
.toast-error { background: #d64545; }

.birthday-modal {
  position: fixed;
  inset: 0;
  z-index: 2100;
  background: rgba(16, 12, 24, 0.55);
  display: grid;
  place-items: center;
  padding: 1rem;
  animation: modalIn 0.24s ease;
}

.birthday-modal.closing {
  opacity: 0;
  transition: opacity 0.22s ease;
}

.birthday-modal-card {
  width: min(760px, 100%);
  max-height: min(84vh, 860px);
  overflow: auto;
  background: linear-gradient(140deg, #fff7f2 0%, #ffeef4 55%, #fff9e8 100%);
  color: #311a2f;
  border: 1px solid rgba(49, 26, 47, 0.12);
  border-radius: 20px;
  box-shadow: 0 28px 80px rgba(0, 0, 0, 0.24);
  padding: 1.4rem 1.25rem 1.25rem;
  position: relative;
}

.birthday-modal-card h2 {
  margin: 0 0 0.85rem;
  font-size: 1.35rem;
  line-height: 1.25;
}

.birthday-modal-card p {
  margin: 0;
  line-height: 1.68;
  white-space: pre-line;
}

.birthday-close {
  position: absolute;
  top: 0.7rem;
  right: 0.7rem;
  border: 0;
  width: 36px;
  height: 36px;
  border-radius: 999px;
  cursor: pointer;
  background: rgba(49, 26, 47, 0.1);
  color: #311a2f;
  font-size: 1.4rem;
  line-height: 1;
}

@keyframes modalIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideIn {
  from { opacity: 0; transform: translateX(12px); }
  to { opacity: 1; transform: translateX(0); }
}
</style>
