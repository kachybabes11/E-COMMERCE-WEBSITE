<%- include('../partials/header.ejs') %>

<main class="page-content orders-page">
  <section class="orders-card">
    <h1>Your Orders</h1>
    <% if (!orders.length) { %>
      <div class="empty-state">
        <p>You haven't placed any orders yet.</p>
        <a href="/products" class="button button-secondary">Start shopping</a>
      </div>
    <% } else { %>
      <div class="orders-list">
        <% orders.forEach((order) => { %>
          <a class="order-row" href="/orders/<%= order.id %>">
            <div>
              <strong><%= order.order_number %></strong>
              <p><%= new Date(order.created_at).toLocaleDateString() %></p>
            </div>
            <div class="order-meta">
              <span class="order-status <%= order.order_status.toLowerCase() %>"><%= order.order_status %></span>
              <span>₦<%= formatCurrency(order.total_amount) %></span>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </section>
</main>

<%- include('../partials/footer.ejs') %>

<style>
.orders-page {
  padding: 3rem 1rem;
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
}

.orders-card {
  max-width: 1040px;
  margin: auto;
  background: var(--surface);
  color: var(--text);
  padding: 2rem;
  border-radius: 24px;
  border: 1px solid var(--surface-border);
  box-shadow: var(--shadow-lg);
  backdrop-filter: blur(10px);
}

.orders-card h1 {
  margin-bottom: 1.5rem;
}

.orders-list {
  display: grid;
  gap: 1rem;
}

.order-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.25rem 1.5rem;
  border-radius: 18px;
  background: var(--surface-strong);
  border: 1px solid var(--surface-border);
  color: inherit;
  text-decoration: none;
  transition: transform 0.2s ease;
}

.order-row:hover {
  transform: translateY(-2px);
}

.order-meta {
  display: flex;
  gap: 1rem;
  align-items: center;
}

.order-status {
  padding: 0.5rem 0.8rem;
  border-radius: 999px;
  font-size: 0.85rem;
  font-weight: 700;
  text-transform: uppercase;
}

.order-status.pending { background: color-mix(in srgb, #c79b3b 18%, var(--surface-strong)); color: #8a6420; }
.order-status.processing { background: color-mix(in srgb, #4a86d4 18%, var(--surface-strong)); color: #295a96; }
.order-status.shipped { background: color-mix(in srgb, #5f9c72 18%, var(--surface-strong)); color: #356245; }
.order-status.delivered { background: color-mix(in srgb, #79a85c 18%, var(--surface-strong)); color: #4a7135; }
.order-status.cancelled { background: color-mix(in srgb, #d67272 18%, var(--surface-strong)); color: #8d3c3c; }

@media (max-width: 720px) {
  .order-row {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .order-meta {
    width: 100%;
    justify-content: space-between;
  }
}
</style>