<%- include('../partials/header.ejs') %>

<main class="page-content cart-page">
  <section class="cart-shell">

    <header class="cart-header">
      <div>
        <h1>Your Cart</h1>
        <p class="cart-subheading">Review your items before checkout.</p>
      </div>
      <a href="/products" class="button button-secondary">← Keep Shopping</a>
    </header>

    <% if (!cart.length) { %>
      <div class="empty-cart">
        <div class="empty-cart-icon">🛍️</div>
        <h2>Nothing here yet</h2>
        <p>Your cart is empty. Discover our curated collection and find your next favourite piece.</p>
        <a href="/products" class="button button-primary">Browse Collection</a>
      </div>
    <% } else { %>

    <div class="cart-layout">

      <div class="cart-items">
        <% cart.forEach((item) => { %>
          <div class="cart-card">
            <div class="cart-info">
              <h3><%= item.product?.name || item.product_name || "Unnamed product" %></h3>
              <p class="cart-meta">Color: <strong><%= item.color %></strong></p>
              <p class="cart-meta">Unit Price: <strong>₦<%= (item.product?.price ?? item.unit_price).toFixed(2) %></strong></p>
              <p class="cart-meta">Quantity: <strong><%= item.quantity %></strong></p>
            </div>

            <div class="cart-price">
              <p class="cart-item-total">₦<%= ((item.product?.price ?? item.unit_price) * item.quantity).toFixed(2) %></p>
              <form action="/cart/remove" method="post">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <input type="hidden" name="productId" value="<%= item.product?.id || item.product_id %>" />
                <input type="hidden" name="color" value="<%= item.color %>" />
                <button class="btn-remove" type="submit">Remove</button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>

      <div class="cart-summary-box">
        <h2>Order Summary</h2>

        <div class="cart-summary-lines">
          <div class="cart-summary-row">
            <span>Subtotal (<%= cart.length %> item<%= cart.length !== 1 ? 's' : '' %>)</span>
            <strong>₦<%= total.toFixed(2) %></strong>
          </div>
          <div class="cart-summary-row">
            <span>Shipping</span>
            <strong>Calculated at checkout</strong>
          </div>
        </div>

        <div class="cart-total-row">
          <span>Estimated Total</span>
          <strong>₦<%= total.toFixed(2) %></strong>
        </div>

        <form action="/checkout" method="get">
          <button class="button button-primary full-width cart-checkout-btn" type="submit">
            Proceed to Checkout →
          </button>
        </form>

        <p class="cart-secure-note">🔒 Secure payment via Paystack</p>
      </div>

    </div>
    <% } %>

  </section>
</main>

<style>
.cart-page {
  padding: 2.5rem 1rem 5rem;
}

.cart-shell {
  width: min(1100px, calc(100% - 1rem));
  margin: 0 auto;
  display: grid;
  gap: 1.8rem;
}

/* ── Header ── */
.cart-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 0.8rem;
}

.cart-header h1 {
  font-size: 2.6rem;
  margin: 0 0 0.1rem;
  color: var(--heading);
}

.cart-subheading {
  margin: 0;
  color: var(--muted);
  font-size: 0.97rem;
}

/* ── Empty state ── */
.empty-cart {
  text-align: center;
  padding: 5rem 2rem;
  background: var(--surface);
  border: 1px solid var(--surface-border);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
  backdrop-filter: blur(10px);
}

.empty-cart-icon {
  font-size: 3.5rem;
  margin-bottom: 1rem;
}

.empty-cart h2 {
  margin: 0 0 0.5rem;
}

.empty-cart p {
  color: var(--muted);
  max-width: 380px;
  margin: 0 auto 1.5rem;
}

/* ── Layout ── */
.cart-layout {
  display: grid;
  grid-template-columns: 1fr minmax(0, 340px);
  gap: 1.5rem;
  align-items: start;
}

/* ── Cart items column ── */
.cart-items {
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
}

.cart-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1.4rem;
  background: var(--surface);
  border: 1px solid var(--surface-border);
  border-radius: 20px;
  padding: 1.3rem 1.6rem;
  box-shadow: var(--shadow-sm);
  backdrop-filter: blur(8px);
  transition: transform 0.22s ease, box-shadow 0.22s ease;
}

.cart-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-lg);
}

.cart-info h3 {
  font-size: 1.18rem;
  margin: 0 0 0.45rem;
  color: var(--heading);
}

.cart-meta {
  font-size: 0.9rem;
  color: var(--muted);
  margin: 0.12rem 0;
}

.cart-meta strong {
  color: var(--text);
}

/* ── Price column ── */
.cart-price {
  text-align: right;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0.55rem;
}

.cart-item-total {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--gold);
  margin: 0;
  font-family: "Cormorant Garamond", Georgia, serif;
  letter-spacing: 0.01em;
}

.btn-remove {
  background: none;
  border: 1px solid transparent;
  cursor: pointer;
  font-size: 0.8rem;
  color: var(--muted);
  letter-spacing: 0.05em;
  text-transform: uppercase;
  padding: 0.3rem 0.65rem;
  border-radius: 8px;
  transition: color 0.15s, background 0.15s, border-color 0.15s;
}

.btn-remove:hover {
  color: #b93535;
  background: color-mix(in srgb, #ffeded 70%, transparent);
  border-color: #f0c0c0;
}

/* ── Summary sidebar ── */
.cart-summary-box {
  background: var(--surface);
  border: 1px solid var(--surface-border);
  border-radius: 22px;
  padding: 1.6rem;
  box-shadow: var(--shadow-sm);
  backdrop-filter: blur(10px);
  position: sticky;
  top: 100px;
  display: grid;
  gap: 1.1rem;
}

.cart-summary-box h2 {
  margin: 0;
  font-size: 1.55rem;
  color: var(--heading);
}

.cart-summary-lines {
  display: grid;
  gap: 0.6rem;
  padding-bottom: 0.9rem;
  border-bottom: 1px solid color-mix(in srgb, var(--surface-border) 75%, #cfc2af 25%);
}

.cart-summary-row {
  display: flex;
  justify-content: space-between;
  font-size: 0.94rem;
  color: var(--muted);
}

.cart-summary-row strong {
  color: var(--text);
}

.cart-total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 1rem;
  font-weight: 600;
  color: var(--heading);
}

.cart-total-row strong {
  color: var(--gold);
  font-size: 1.3rem;
  font-family: "Cormorant Garamond", Georgia, serif;
}

.cart-checkout-btn {
  padding: 1rem;
  font-size: 1rem;
  border-radius: 14px;
  letter-spacing: 0.06em;
}

.cart-secure-note {
  margin: 0;
  text-align: center;
  font-size: 0.82rem;
  color: var(--muted);
}

/* ── Responsive ── */
@media (max-width: 820px) {
  .cart-layout {
    grid-template-columns: 1fr;
  }

  .cart-summary-box {
    position: static;
  }
}

@media (max-width: 560px) {
  .cart-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .cart-card {
    flex-direction: column;
    align-items: flex-start;
  }

  .cart-price {
    text-align: left;
    align-items: flex-start;
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
  }
}
</style>

<%- include('../partials/footer.ejs') %>
