<%- include('../partials/header.ejs') %>

<main class="page-content order-detail-page">
  <section class="order-detail-card">
    <h1>Order <%= order.order_number %></h1>
    <p class="subheading">Placed on <%= new Date(order.created_at).toLocaleString() %></p>

    <div class="status-grid">
      <div>
        <span>Status</span>
        <strong><%= order.order_status %></strong>
      </div>
      <div>
        <span>Payment</span>
        <strong><%= order.payment_status %></strong>
      </div>
      <div>
        <span>Total</span>
        <strong>₦<%= formatCurrency(order.total_amount) %></strong>
      </div>
    </div>

    <div class="address-card">
      <h2>Shipping Address</h2>
      <p><%= order.shipping_address.street %></p>
      <p><strong>Phone:</strong> <%= order.phone %></p>
    </div>

    <div class="items-card">
      <h2>Items</h2>
      <% items.forEach((item) => { %>
        <div class="item-row">
          <div>
            <strong><%= item.product_name %></strong>
            <p><%= item.color %></p>
          </div>
          <div>
            <p><%= item.quantity %> x ₦<%= formatCurrency(item.unit_price) %></p>
            <p><strong>₦<%= formatCurrency(item.total_price) %></strong></p>
          </div>
        </div>
      <% }) %>
    </div>

    <a href="/orders" class="button button-secondary">Back to orders</a>
  </section>
</main>

<%- include('../partials/footer.ejs') %>

<style>
.order-detail-page {
  padding: 3rem 1rem;
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
}

.order-detail-card {
  max-width: 1000px;
  margin: auto;
  background: var(--surface);
  color: var(--text);
  border-radius: 26px;
  padding: 2rem;
  border: 1px solid var(--surface-border);
  box-shadow: var(--shadow-lg);
  backdrop-filter: blur(10px);
}

.status-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(180px, 1fr));
  gap: 1rem;
  margin: 1.5rem 0;
}

.status-grid div {
  background: var(--surface-strong);
  border: 1px solid var(--surface-border);
  padding: 1rem;
  border-radius: 16px;
}

.address-card,
.items-card {
  background: var(--surface-strong);
  border: 1px solid var(--surface-border);
  padding: 1.5rem;
  border-radius: 18px;
  margin-bottom: 1.5rem;
}

.item-row {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  padding: 1rem 0;
  border-bottom: 1px solid color-mix(in srgb, var(--surface-border) 70%, #d8cfbe 30%);
}

.item-row:last-child { border-bottom: none; }

@media (max-width: 720px) {
  .status-grid {
    grid-template-columns: 1fr;
  }

  .item-row {
    flex-direction: column;
  }
}
</style>