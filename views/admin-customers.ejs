<%- include('../partials/header.ejs') %>

<main class="page-content admin-page">
  <section class="admin-shell">
    <div class="admin-top">
      <h1>Customers</h1>
      <form action="/admin/customers" method="get" class="search-form">
        <input type="text" name="search" placeholder="Search by email" value="<%= search %>" />
        <button class="button button-primary" type="submit">Search</button>
      </form>
    </div>

    <div class="admin-list">
      <% customers.forEach((customer) => { %>
      <a class="admin-item" href="/admin/customers/<%= customer.id %>">
        <div>
          <h3><%= customer.email %></h3>
          <small>Joined <%= new Date(customer.created_at).toLocaleDateString() %></small>
        </div>
        <div><strong><%= customer.total_orders %></strong><span>Orders</span></div>
        <div><strong>N<%= formatCurrency(customer.total_spent) %></strong><span>Spent</span></div>
      </a>
      <% }) %>
    </div>
  </section>
</main>

<style>
.admin-page { padding: 2rem 1rem; background: var(--bg); color: var(--text); }
.admin-shell { max-width: 1100px; margin: auto; }
.admin-top { display: flex; justify-content: space-between; align-items: center; background: var(--surface); border: 1px solid var(--surface-border); border-radius: 14px; padding: 1rem; box-shadow: var(--shadow-sm); backdrop-filter: blur(10px); }
.search-form { display: flex; gap: 0.5rem; }
.search-form input { border: 1px solid color-mix(in srgb, var(--surface-border) 70%, #d2d8c9 30%); border-radius: 10px; padding: 0.6rem 0.7rem; background: var(--surface-strong); color: var(--text); }
.admin-list { margin-top: 1rem; display: grid; gap: 0.7rem; }
.admin-item { display: grid; grid-template-columns: 2fr 1fr 1fr; background: var(--surface); border-radius: 12px; padding: 0.9rem; text-decoration: none; color: inherit; border: 1px solid var(--surface-border); box-shadow: var(--shadow-sm); backdrop-filter: blur(10px); }
.admin-item span { display: block; color: var(--muted); }
@media (max-width: 820px) { .admin-item { grid-template-columns: 1fr; } }
</style>

<%- include('../partials/footer.ejs') %>
