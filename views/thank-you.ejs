<%- include('../partials/header.ejs') %>

<main class="page-content checkout-page">
  <section class="checkout-card success-card">
    <div class="success-icon">✅</div>
    <h1>Thank you for your order!</h1>
    <p class="thank-you">Your order has been processed successfully.</p>

    <div class="order-details-card">
      <div class="details-row">
        <span>Order Number</span>
        <strong><%= order.order_number %></strong>
      </div>
      <div class="details-row">
        <span>Customer</span>
        <strong><%= order.customer_name %></strong>
      </div>
      <div class="details-row">
        <span>Order Date</span>
        <strong><%= new Date(order.created_at).toLocaleString() %></strong>
      </div>
      <div class="details-row">
        <span>Status</span>
        <strong><%= order.order_status %></strong>
      </div>
      <div class="details-row">
        <span>Total Amount</span>
        <strong>₦<%= formatCurrency(order.total_amount) %></strong>
      </div>
    </div>

    <div class="shipping-card">
      <h2>Shipping Address</h2>
      <p><%= order.shipping_address.street %></p>
      <p><%= order.shipping_address.city %>, <%= order.shipping_address.state %></p>
      <p><%= order.shipping_address.postalCode %>, <%= order.shipping_address.country %></p>
    </div>

    <div class="order-items-card">
      <h2>Products Ordered</h2>
      <% items.forEach((item) => { %>
        <div class="item-row">
          <div>
            <strong><%= item.product_name %></strong>
            <p><%= item.color %></p>
          </div>
          <div>
            <p><%= item.quantity %> x ₦<%= formatCurrency(item.unit_price) %></p>
            <p><strong>₦<%= formatCurrency(item.total_price) %></strong></p>
          </div>
        </div>
      <% }) %>
    </div>

    <a href="/orders" class="button button-primary">View your orders</a>
  </section>

  <section class="checkout-card review-form-card">
    <h2>How was your experience?</h2>
    <p class="review-subtitle">We'd love to hear from you. Leave a quick review for your order.</p>

    <%- include('./partials/messages.ejs') %>

    <form action="/reviews" method="post" class="review-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="order_id" value="<%= order.id %>" />

      <div class="review-field">
        <label for="reviewer_name">Your Name</label>
        <input id="reviewer_name" name="reviewer_name" value="<%= order.customer_name %>" required />
      </div>

      <div class="review-field">
        <label>Rating</label>
        <div class="star-picker" id="starPicker">
          <% [1,2,3,4,5].forEach(function(n) { %>
          <label class="star-label">
            <input type="radio" name="rating" value="<%= n %>" required />
            <span>★</span>
          </label>
          <% }) %>
        </div>
      </div>

      <div class="review-field">
        <label for="review_text">Your Review</label>
        <textarea id="review_text" name="review_text" rows="4" placeholder="Tell us about your bag, delivery, and overall experience…" required maxlength="1000"></textarea>
      </div>

      <button type="submit" class="button button-primary">Submit Review</button>
    </form>
  </section>
</main>

<%- include('../partials/footer.ejs') %>

<style>
.checkout-page {
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 3rem 1rem;
  background: #f6f7fb;
}

.checkout-card {
  width: 100%;
  max-width: 760px;
  background: #fff;
  border-radius: 28px;
  padding: 2.5rem;
  box-shadow: 0 30px 70px rgba(0,0,0,0.12);
}

.success-card {
  text-align: center;
}

.success-icon {
  font-size: 3.5rem;
  margin-bottom: 1rem;
}

.order-details-card,
.shipping-card,
.order-items-card {
  text-align: left;
  background: #f9fbff;
  border-radius: 18px;
  padding: 1.5rem;
  margin-top: 1.5rem;
}

.details-row,
.item-row {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 1rem;
  align-items: center;
}

.order-items-card h2,
.shipping-card h2 {
  margin-top: 0;
}

.order-items-card .item-row {
  border-bottom: 1px solid #e8edf6;
  padding-bottom: 1rem;
}

.order-items-card .item-row:last-child {
  border-bottom: none;
}

.review-form-card {
  margin-top: 1.5rem;
  text-align: left;
}

.review-form-card h2 {
  margin: 0 0 0.25rem;
}

.review-subtitle {
  color: #666;
  margin: 0 0 1.5rem;
  font-size: 0.97rem;
}

.review-form {
  display: grid;
  gap: 1.1rem;
}

.review-field {
  display: grid;
  gap: 0.4rem;
}

.review-field label {
  font-weight: 700;
  font-size: 0.95rem;
}

.review-field input,
.review-field textarea {
  padding: 0.75rem 0.9rem;
  border: 1px solid #dde2ec;
  border-radius: 12px;
  font-size: 1rem;
  font-family: inherit;
  background: #fafbff;
  resize: vertical;
}

.star-picker {
  display: flex;
  gap: 0.3rem;
}

.star-label {
  cursor: pointer;
  font-size: 1.9rem;
  color: #ccc;
  transition: color 0.15s;
}

.star-label input {
  display: none;
}

.star-label.selected span,
.star-label:hover span,
.star-label:hover ~ .star-label span {
  color: #f5a623;
}
</style>

<script>
  (function () {
    const labels = Array.from(document.querySelectorAll('.star-label'));
    labels.forEach(function (label, index) {
      label.addEventListener('mouseenter', function () {
        labels.forEach(function (l, i) {
          l.querySelector('span').style.color = i <= index ? '#f5a623' : '#ccc';
        });
      });
      label.addEventListener('mouseleave', function () {
        highlightSelected();
      });
      label.querySelector('input').addEventListener('change', function () {
        highlightSelected();
      });
    });
    function highlightSelected() {
      const checked = document.querySelector('.star-label input:checked');
      const checkedIndex = checked ? labels.indexOf(checked.closest('.star-label')) : -1;
      labels.forEach(function (l, i) {
        l.querySelector('span').style.color = i <= checkedIndex ? '#f5a623' : '#ccc';
      });
    }
  })();
</script>