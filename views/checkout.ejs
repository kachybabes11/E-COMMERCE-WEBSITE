<%- include('../partials/header.ejs') %>

<main class="page-content checkout-page" data-checkout-subtotal="<%= Number(subtotal || 0) %>">
  <section class="checkout-shell" data-reveal>
    <header class="checkout-hero glass-card">
      <nav class="checkout-breadcrumb">
        <a href="/cart">Cart</a>
        <span>›</span>
        <strong>Details</strong>
        <span>›</span>
        <span class="bc-dim">Payment</span>
      </nav>
      <h1>Secure Checkout</h1>
      <p>Fill in your delivery details. You’ll be redirected to Paystack to complete payment securely.</p>
    </header>

    <% if (errors && errors.length) { %>
    <section class="form-errors glass-card" aria-live="assertive">
      <h2>Please fix the following</h2>
      <ul>
        <% errors.forEach((error) => { %>
        <li><%= error.msg %></li>
        <% }) %>
      </ul>
    </section>
    <% } %>

    <div class="checkout-grid">
      <form action="/checkout" method="post" class="checkout-form glass-card" id="checkoutForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <section class="checkout-section">
          <h2>Contact & Address</h2>

          <div class="form-group">
            <label for="customerName">Full Name</label>
            <input id="customerName" name="customerName" value="<%= formData.customerName || "" %>" required />
          </div>

          <div class="form-group">
            <label for="phone">Phone Number</label>
            <input id="phone" name="phone" value="<%= formData.phone || "" %>" required />
          </div>

          <div class="form-group">
            <label for="street">Street Address</label>
            <input id="street" name="street" value="<%= formData.street || "" %>" required />
          </div>
        </section>

        <section class="checkout-section shipping-group">
          <h2>Shipping Method</h2>

          <label class="shipping-option">
            <input type="radio" name="shippingMethod" value="pickup" <%= (formData.shippingMethod === "pickup" || !formData.shippingMethod) ? "checked" : "" %> />
            <span>
              <strong>Pickup (Ojota)</strong>
              <small>Free</small>
            </span>
          </label>

          <label class="shipping-option">
            <input type="radio" name="shippingMethod" value="lagos" <%= formData.shippingMethod === "lagos" ? "checked" : "" %> />
            <span>
              <strong>Lagos Delivery</strong>
              <small>Flat by area</small>
            </span>
          </label>

          <div class="lagos-area" id="lagosAreaWrap">
            <label for="lagosArea">Lagos Delivery Area</label>
            <select id="lagosArea" name="lagosArea">
              <option value="" <%= !formData.lagosArea ? "selected" : "" %>>Select your delivery area</option>
              <option value="not_listed" <%= formData.lagosArea === "not_listed" ? "selected" : "" %>>My area is not listed — Negotiated</option>
              <% lagosDeliveryAreas.forEach((area) => { %>
              <option value="<%= area.value %>" <%= formData.lagosArea === area.value ? "selected" : "" %>><%= area.label %> — ₦<%= formatCurrency(area.fee) %></option>
              <% }) %>
            </select>
            <p class="lagos-contact-note" id="lagosContactNote">If your Lagos location is not specified, please message us on WhatsApp after payment so we can process your delivery — <a href="https://wa.me/2347088069114" target="_blank" rel="noreferrer" class="checkout-inline-link"><strong>Chat +234 708 806 9114</strong></a>.</p>
          </div>

          <label class="shipping-option">
            <input type="radio" name="shippingMethod" value="outside" <%= formData.shippingMethod === "outside" ? "checked" : "" %> />
            <span>
              <strong>Outside Lagos/Nigeria</strong>
              <small>Fee negotiated after order</small>
            </span>
          </label>

          <div class="outside-lagos-notice" id="outsideLagosNotice">
            <p>📦 After payment, please send your receipt to our WhatsApp — <a href="https://wa.me/2347088069114" target="_blank" rel="noreferrer" class="checkout-inline-link"><strong>Chat +234 708 806 9114</strong></a> — so we can confirm your shipping fee and process your delivery.</p>
          </div>
        </section>

        <button type="submit" class="button button-primary full-width checkout-submit">
          🔒 Pay Securely with Paystack
        </button>
      </form>

      <aside class="checkout-summary glass-card">
        <h2>Order Summary</h2>

        <div class="summary-list">
          <% cart.forEach((item) => { %>
          <article class="summary-item">
            <div>
              <h3><%= item.product_name || item.product?.name || "Product" %></h3>
              <p><%= item.color %> • Qty <%= item.quantity %></p>
            </div>
            <strong>₦<%= formatCurrency((item.unit_price || item.product?.price || 0) * item.quantity) %></strong>
          </article>
          <% }) %>
        </div>

        <div class="summary-totals">
          <div class="summary-row">
            <span>Subtotal</span>
            <strong>₦<%= formatCurrency(subtotal) %></strong>
          </div>
          <div class="summary-row">
            <span>Shipping</span>
            <strong id="shippingPreview">Calculated after selection</strong>
          </div>
          <div class="summary-row total">
            <span>Estimated Total</span>
            <strong id="totalPreview">₦<%= formatCurrency(subtotal) %></strong>
          </div>
        </div>

        <p class="summary-note">Stock is revalidated right before payment to protect against overselling.</p>
      </aside>
    </div>
  </section>
</main>

<script type="application/json" id="lagosDeliveryFeesData"><%- JSON.stringify(Object.fromEntries(lagosDeliveryAreas.map((area) => [area.value, area.fee]))) %></script>

<script>
  window.addEventListener("DOMContentLoaded", function () {
    const checkoutForm = document.getElementById("checkoutForm");
    const shippingInputs = Array.from(document.querySelectorAll('input[name="shippingMethod"]'));
    const lagosArea = document.getElementById("lagosArea");
    const lagosWrap = document.getElementById("lagosAreaWrap");
    const outsideLagosNotice = document.getElementById("outsideLagosNotice");
    const shippingPreview = document.getElementById("shippingPreview");
    const totalPreview = document.getElementById("totalPreview");
    const submitButton = document.querySelector(".checkout-submit");
    const subtotal = Number(document.querySelector('.checkout-page')?.getAttribute('data-checkout-subtotal') || 0);
    const shippingFeesData = document.getElementById("lagosDeliveryFeesData");
    const shippingFees = shippingFeesData ? JSON.parse(shippingFeesData.textContent || "{}") : {};

    function selectedMethod() {
      const active = shippingInputs.find((input) => input.checked);
      return active ? active.value : "pickup";
    }

    function refreshPreview() {
      const method = selectedMethod();
      let fee = 0;
      let feeLabel = "Free";

      if (method === "lagos") {
        const area = lagosArea ? lagosArea.value : "";
        if (!area) {
          fee = 0;
          feeLabel = "Select area";
        } else if (area === "not_listed") {
          fee = 0;
          feeLabel = "Negotiated";
        } else {
          fee = shippingFees[area] || 0;
          feeLabel = "₦" + Number(fee).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
      } else if (method === "outside") {
        feeLabel = "Negotiated";
      }

      if (lagosWrap) {
        lagosWrap.classList.toggle("active", method === "lagos");
      }

      if (lagosArea) {
        lagosArea.disabled = method !== "lagos";
        lagosArea.required = false;
      }

      if (outsideLagosNotice) {
        outsideLagosNotice.classList.toggle("active", method === "outside");
      }

      if (shippingPreview) {
        shippingPreview.textContent = feeLabel;
      }

      if (totalPreview) {
        const total = subtotal + fee;
        totalPreview.textContent = "₦" + Number(total).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      }
    }

    shippingInputs.forEach((input) => {
      input.addEventListener("change", refreshPreview);
    });

    if (lagosArea) {
      lagosArea.addEventListener("change", refreshPreview);
    }

    if (checkoutForm && submitButton) {
      checkoutForm.addEventListener("submit", function () {
        submitButton.disabled = true;
        submitButton.textContent = "Redirecting to Paystack...";
      });
    }

    refreshPreview();
  });
</script>

<style>
.checkout-page {
  padding: 2.2rem 1rem 3.2rem;
}

.checkout-shell {
  width: min(1200px, calc(100% - 0.2rem));
  margin: 0 auto;
  display: grid;
  gap: 1rem;
}

.glass-card {
  background: var(--surface);
  border: 1px solid var(--surface-border);
  border-radius: 22px;
  box-shadow: var(--shadow-sm);
  backdrop-filter: blur(8px);
}

.checkout-hero {
  padding: 1.3rem 1.4rem;
}

.checkout-hero h1 {
  margin-bottom: 0.2rem;
}

.checkout-hero p {
  margin: 0;
  color: var(--muted);
}

.checkout-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
  gap: 1rem;
  align-items: start;
}

.form-errors {
  background: color-mix(in srgb, #ffdfdf 72%, white);
  border: 1px solid #f0b8b8;
  padding: 1rem 1.25rem;
}

.form-errors h2 {
  margin: 0 0 0.45rem;
  font-size: 1.05rem;
}

.form-errors ul {
  margin: 0;
  padding-left: 1.1rem;
  color: #8f1c1c;
}

.checkout-form {
  display: grid;
  gap: 1.1rem;
  padding: 1.2rem;
}

.checkout-section {
  display: grid;
  gap: 0.85rem;
}

.checkout-section h2 {
  margin: 0;
  font-size: 1.45rem;
}

.form-group {
  display: grid;
}

.form-group label {
  margin-bottom: 0.35rem;
  font-weight: 700;
  letter-spacing: 0.01em;
  color: var(--heading);
}

.form-group input,
.form-group select {
  padding: 0.8rem 0.95rem;
  border: 1px solid color-mix(in srgb, var(--surface-border) 75%, #c5baa8 25%);
  border-radius: 13px;
  font-size: 1rem;
  background: var(--surface-strong);
  color: var(--text);
  transition: border-color 0.18s, box-shadow 0.18s;
}

.form-group input:focus,
.form-group select:focus {
  outline: none;
  border-color: var(--gold);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--gold) 18%, transparent);
}

.grid-two {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.85rem;
}

.shipping-group {
  border: 1px solid color-mix(in srgb, var(--surface-border) 70%, #d7cab5 30%);
  border-radius: 18px;
  padding: 1rem;
  background: color-mix(in srgb, var(--surface-strong) 90%, #f4eee3 10%);
}

.shipping-option {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 0.7rem;
  align-items: center;
  margin-bottom: 0.7rem;
  padding: 0.65rem 0.7rem;
  border-radius: 12px;
  border: 1px solid color-mix(in srgb, var(--surface-border) 75%, #d6cbb9 25%);
  background: var(--surface-strong);
  cursor: pointer;
  transition: border-color 0.18s, background 0.18s;
}

.shipping-option:has(input:checked) {
  border-color: var(--gold);
  background: color-mix(in srgb, var(--gold) 9%, var(--surface-strong));
}

.shipping-option span {
  display: grid;
  line-height: 1.2;
}

.shipping-option small {
  color: var(--muted);
}

.lagos-area {
  margin: 0.15rem 0 0.75rem;
  display: none;
}

.lagos-area.active {
  display: block;
}

.lagos-contact-note {
  margin: 0.65rem 0 0;
  padding: 0.75rem 0.8rem;
  border-radius: 12px;
  border: 1px dashed #d9a536;
  background: color-mix(in srgb, #fff7e1 84%, white);
  color: #6d4d00;
  font-size: 0.93rem;
  line-height: 1.5;
}

.outside-lagos-notice {
  display: none;
  margin: 0.15rem 0 0.5rem;
  padding: 0.85rem 1rem;
  border-radius: 12px;
  background: color-mix(in srgb, #fff8e6 80%, white);
  border: 1px solid #f0d080;
  color: #7a5800;
  font-size: 0.97rem;
  line-height: 1.55;
}

.outside-lagos-notice.active {
  display: block;
}

.outside-lagos-notice a {
  color: #5a3e00;
}

.checkout-inline-link {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  margin: 0 0.2rem;
  padding: 0.2rem 0.5rem;
  border-radius: 999px;
  background: #fff;
  border: 1px solid #d9a536;
  color: #2d6a2f;
  font-weight: 800;
  text-decoration: underline;
  text-underline-offset: 3px;
}

.checkout-inline-link:hover {
  color: #1e4e22;
}

.checkout-submit {
  margin-top: 0.5rem;
  padding: 1.05rem 1.2rem;
  font-size: 1.05rem;
  border-radius: 16px;
  letter-spacing: 0.05em;
}

.checkout-breadcrumb {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.88rem;
  color: var(--muted);
  margin-bottom: 0.75rem;
}

.checkout-breadcrumb a {
  color: var(--gold);
  text-decoration: underline;
  text-underline-offset: 3px;
}

.checkout-breadcrumb strong {
  color: var(--heading);
}

.bc-dim {
  opacity: 0.45;
}

.checkout-summary {
  padding: 1.15rem;
  position: sticky;
  top: 110px;
}

.checkout-summary h2 {
  margin: 0 0 0.8rem;
}

.summary-list {
  display: grid;
  gap: 0.55rem;
  margin-bottom: 0.95rem;
}

.summary-item {
  display: flex;
  justify-content: space-between;
  gap: 0.8rem;
  border: 1px solid color-mix(in srgb, var(--surface-border) 75%, #d4c8b7 25%);
  border-radius: 12px;
  padding: 0.65rem 0.7rem;
  background: var(--surface-strong);
}

.summary-item h3 {
  font-size: 1rem;
  margin: 0;
}

.summary-item p {
  margin: 0.1rem 0 0;
  color: var(--muted);
  font-size: 0.92rem;
}

.summary-item strong {
  white-space: nowrap;
}

.summary-totals {
  border-top: 1px solid color-mix(in srgb, var(--surface-border) 80%, #cfc2af 20%);
  padding-top: 0.75rem;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 0.72rem;
}

.summary-row.total {
  border-top: 1px solid color-mix(in srgb, var(--surface-border) 80%, #cfc2af 20%);
  margin-top: 0.2rem;
  padding-top: 0.8rem;
  font-weight: 800;
}

.summary-note {
  margin: 0.25rem 0 0;
  color: var(--muted);
  font-size: 0.9rem;
}

.full-width {
  width: 100%;
}

@media (max-width: 980px) {
  .checkout-grid {
    grid-template-columns: 1fr;
  }

  .checkout-summary {
    position: static;
  }
}

@media (max-width: 720px) {
  .grid-two {
    grid-template-columns: 1fr;
  }

  .shipping-group {
    padding: 0.85rem;
    gap: 0.7rem;
  }

  .shipping-option {
    padding: 0.8rem 0.75rem;
    align-items: start;
  }

  .shipping-option input[type="radio"] {
    width: 1.05rem;
    height: 1.05rem;
    margin-top: 0.15rem;
  }

  .lagos-area {
    margin: 0.1rem 0 0.65rem;
  }

  .lagos-area label {
    display: inline-block;
    margin-bottom: 0.35rem;
    font-size: 0.92rem;
    font-weight: 700;
  }

  .lagos-area select {
    width: 100%;
    min-height: 2.9rem;
    font-size: 0.98rem;
    border-radius: 12px;
    -webkit-appearance: none;
    appearance: none;
    background-position: right 0.8rem center;
  }

  .lagos-contact-note {
    margin-top: 0.55rem;
    padding: 0.72rem 0.75rem;
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .checkout-inline-link {
    margin: 0.3rem 0 0;
  }
}
</style>

<%- include('../partials/footer.ejs') %>

