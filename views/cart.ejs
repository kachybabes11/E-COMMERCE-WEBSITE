<%- include('../partials/header.ejs') %>

<main class="page-content cart-page">
  <section class="cart-summary">
    <h1>Your Cart</h1>

    <% if (!cart.length) { %>
      <div class="empty-state">
        <p>Your cart is empty.</p>
        <a href="/products" class="button button-secondary">Browse products</a>
      </div>
    <% } else { %>

    <div class="cart-layout">

      <!-- CART ITEMS -->
      <div class="cart-items">
        <% cart.forEach((item) => { %>
          <div class="cart-card">
            
            <div class="cart-info">
              <h3><%= item.product?.name || item.product_name || "Unnamed product" %></h3>

              <p class="cart-meta">
                Color: <strong><%= item.color %></strong>
              </p>

              <p class="cart-meta">
                Unit Price: ₦<%= (item.product?.price ?? item.unit_price).toFixed(2) %>
              </p>

              <p class="cart-meta">
                Quantity: <strong><%= item.quantity %></strong>
              </p>
            </div>

            <div class="cart-price">
              <p>
                ₦<%= ((item.product?.price ?? item.unit_price) * item.quantity).toFixed(2) %>
              </p>

              <form action="/cart/remove" method="post">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <input type="hidden" name="productId" value="<%= item.product?.id || item.product_id %>" />
                <input type="hidden" name="color" value="<%= item.color %>" />
                <button class="button button-link">Remove</button>
              </form>
            </div>

          </div>
        <% }) %>
      </div>

      <!-- SUMMARY -->
      <div class="cart-summary-box">

        <h2>Order Summary</h2>

        <p class="summary-line">
          Subtotal: <span>₦<%= total.toFixed(2) %></span>
        </p>

        <!-- SHIPPING OPTIONS -->
      <div class="shipping-box">
  <h3>Shipping Method</h3>

  <!-- PICKUP -->
  <label>
    <input type="radio" name="shipping" value="pickup" checked />
    Pickup (Free)
  </label>

  <!-- LAGOS -->
  <label>
    <input type="radio" name="shipping" value="lagos" />
    Lagos Delivery
  </label>

  <div id="lagosDropdown" class="hidden">
    <select id="lagosArea">
      <option value="ikeja">Ikeja — ₦3,000</option>
      <option value="lekki">Lekki — ₦5,000</option>
      <option value="yaba">Yaba — ₦2,500</option>
      <option value="ajah">Ajah — ₦6,000</option>
    </select>
  </div>

  <!-- OUTSIDE LAGOS -->
  <label>
    <input type="radio" name="shipping" value="outside" />
    Outside Lagos (Price on request)
  </label>

  <p id="outsideNote" class="hidden">
    Delivery fee will be negotiated after order confirmation.
  </p>
</div>

        <p class="summary-line total">
          Total: <span id="finalTotal">₦<%= (total + 5).toFixed(2) %></span>
        </p>

        <form action="/checkout" method="get">
          <button class="button button-primary full-width">
            Proceed to Checkout
          </button>
        </form>

      </div>

    </div>
    <% } %>

  </section>
</main>
<style>
  /* =========================
   CART PAGE STYLING
========================= */

.hidden {
  display: none;
}

.shipping-box select {
  margin-top: 0.5rem;
  padding: 0.6rem;
  border-radius: 8px;
  border: 1px solid #ddd;
  width: 100%;
}

#outsideNote {
  margin-top: 0.8rem;
  font-size: 0.9rem;
  color: #ff4d4d;
}

.cart-page {
  padding: 3rem 1.5rem;
  background: #f6f7fb;
  min-height: 100vh;
  font-family: "Inter", sans-serif;
}

.cart-summary h1 {
  font-size: 2.2rem;
  margin-bottom: 2rem;
  color: #1a1a2e;
}

/* EMPTY STATE */
.empty-state {
  text-align: center;
  padding: 4rem 2rem;
  background: #fff;
  border-radius: 20px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.05);
}

.empty-state p {
  font-size: 1.2rem;
  margin-bottom: 1rem;
  color: #666;
}

/* MAIN LAYOUT */
.cart-layout {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 2rem;
  align-items: start;
}

/* CART ITEMS */
.cart-items {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.cart-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  padding: 1.5rem;
  border-radius: 16px;
  box-shadow: 0 10px 25px rgba(0,0,0,0.05);
  transition: transform 0.2s ease;
}

.cart-card:hover {
  transform: translateY(-3px);
}

.cart-info h3 {
  margin-bottom: 0.5rem;
  color: #1a1a2e;
  font-size: 1.2rem;
}

.cart-meta {
  font-size: 0.95rem;
  color: #666;
  margin: 0.2rem 0;
}

/* PRICE SECTION */
.cart-price {
  text-align: right;
}

.cart-price p {
  font-size: 1.2rem;
  font-weight: bold;
  color: #667eea;
}

/* ORDER SUMMARY BOX */
.cart-summary-box {
  background: #fff;
  padding: 2rem;
  border-radius: 18px;
  box-shadow: 0 10px 25px rgba(0,0,0,0.06);
  position: sticky;
  top: 20px;
}

.cart-summary-box h2 {
  margin-bottom: 1.5rem;
  color: #1a1a2e;
}

/* SUMMARY LINES */
.summary-line {
  display: flex;
  justify-content: space-between;
  margin-bottom: 1rem;
  font-size: 1rem;
  color: #444;
}

.summary-line.total {
  font-size: 1.3rem;
  font-weight: bold;
  color: #1a1a2e;
  border-top: 1px solid #eee;
  padding-top: 1rem;
}

/* SHIPPING BOX */
.shipping-box {
  margin: 1.5rem 0;
  padding: 1rem;
  background: #f9f9ff;
  border-radius: 12px;
  border: 1px solid #e6e6ff;
}

.shipping-box h3 {
  margin-bottom: 0.8rem;
  font-size: 1rem;
  color: #333;
}

.shipping-box label {
  display: block;
  margin-bottom: 0.6rem;
  font-size: 0.95rem;
  color: #555;
  cursor: pointer;
}

.shipping-box input {
  margin-right: 8px;
}

/* BUTTON */
.button {
  display: inline-block;
  padding: 0.8rem 1.2rem;
  border-radius: 10px;
  border: none;
  cursor: pointer;
  font-weight: 600;
  transition: all 0.3s ease;
}

.button-primary {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
}

.button-primary:hover {
  transform: scale(1.03);
  box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
}

.button-link {
  background: transparent;
  color: #ff4d4d;
  padding: 0;
}

.button-link:hover {
  text-decoration: underline;
}

/* FULL WIDTH BUTTON */
.full-width {
  width: 100%;
  margin-top: 1rem;
}

/* RESPONSIVE */
@media (max-width: 768px) {
  .cart-layout {
    grid-template-columns: 1fr;
  }

  .cart-card {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .cart-price {
    text-align: left;
  }

  .cart-summary-box {
    position: static;
  }
}
</style>

<script>
const radios = document.querySelectorAll('input[name="shipping"]')
const lagosDropdown = document.getElementById("lagosDropdown")
const outsideNote = document.getElementById("outsideNote")

const lagosArea = document.getElementById("lagosArea")

const baseTotal = <%= total %>

const lagosPrices = {
  ikeja: 3000,
  lekki: 5000,
  yaba: 2500,
  ajah: 6000
}

let shippingCost = 0

function updateTotal() {
  document.getElementById("finalTotal").innerText =
    `₦${(baseTotal + shippingCost).toLocaleString()}`
}

radios.forEach(radio => {
  radio.addEventListener("change", () => {

    if (radio.value === "pickup") {
      lagosDropdown.classList.add("hidden")
      outsideNote.classList.add("hidden")
      shippingCost = 0
    }

    if (radio.value === "lagos") {
      lagosDropdown.classList.remove("hidden")
      outsideNote.classList.add("hidden")
      shippingCost = lagosPrices[lagosArea.value]
    }

    if (radio.value === "outside") {
      lagosDropdown.classList.add("hidden")
      outsideNote.classList.remove("hidden")
      shippingCost = 0
    }

    updateTotal()
  })
})

// when user changes area
lagosArea.addEventListener("change", () => {
  shippingCost = lagosPrices[lagosArea.value]
  updateTotal()
})
</script>

<%- include('../partials/footer.ejs') %>
