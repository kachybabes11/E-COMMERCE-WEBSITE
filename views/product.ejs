<%- include('../partials/header.ejs') %>
<%- include('./partials/messages.ejs') %>

<main class="page-content product-page luxury-product-page" data-product-page>
  <section class="single-product">
    <div class="product-media" data-reveal>
      <div class="image-slideshow glass-card">
        <div class="slideshow-container" id="slideshow"></div>

        <div class="color-swatches">
          <p class="color-label">Choose color</p>
          <div class="swatches-container">
            <% product.colors.forEach((color, index) => { %>
            <button type="button" class="color-swatch <%= index === 0 ? 'active' : '' %>" data-color-index="<%= index %>"><%= color.name %></button>
            <% }) %>
          </div>
        </div>

        <div class="slide-indicators" id="indicators"></div>
      </div>
    </div>

    <div class="product-details glass-card" data-reveal>
      <span class="category-label"><%= Array.isArray(product.category) ? product.category.join(' / ') : product.category %></span>
      <h1><%= product.name %></h1>
      <p class="product-description"><%= product.description %></p>
      <p class="price large">N<%= product.price.toFixed(2) %></p>

      <div class="product-meta">
        <% const firstVariant = product.colors[0]; %>
        <% const firstQty = Number(firstVariant?.stock || 0); %>
        <% const initialStatus = firstVariant?.availability === 'Out of Stock' || firstQty <= 0 ? 'Out of Stock' : firstQty < 5 ? `${firstQty} unit${firstQty === 1 ? '' : 's'} left` : 'In Stock'; %>
        <p>Availability: <strong class="stock-info" id="stockStatus"><%= initialStatus %></strong></p>
        <button type="button" class="button button-link" data-open-size-guide>View Size Guide</button>
      </div>

      <form action="/wishlist/toggle" method="post" class="inline-form" data-wishlist-form>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="productId" value="<%= product.id %>" />
        <input type="hidden" name="color" id="wishlistColor" value="<%= product.colors[0].name %>" />
        <button type="submit" class="wishlist-main-btn <%= wishlisted ? 'saved' : '' %>" data-product-id="<%= product.id %>" data-color="<%= product.colors[0].name %>" data-wishlist-toggle><%= wishlisted ? '♥ Saved' : '♡ Save to Wishlist' %></button>
      </form>

      <form action="/cart/add" method="post" class="product-form" data-ajax-cart data-sticky-source>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="productId" value="<%= product.id %>" />
        <input type="hidden" name="color" id="selectedColor" value="<%= product.colors[0].name %>" />

        <div class="form-row">
          <label for="quantity">Quantity</label>
          <input type="number" id="quantity" name="quantity" min="1" max="99" value="1" required />
        </div>

        <button type="submit" class="button button-primary full-width" id="addToCartBtn" <%= (firstVariant?.stock || 0) <= 0 ? 'disabled' : '' %>><%= (firstVariant?.stock || 0) <= 0 ? 'Out of Stock' : 'Add to Cart' %></button>
      </form>
    </div>
  </section>

  <section class="recommendations" data-reveal>
    <div class="section-header">
      <h2>You May Also Like</h2>
      <p>Complete the look with related pieces.</p>
    </div>
    <div class="product-grid premium-grid">
      <% recommendations.forEach((item) => { %>
      <article class="product-card" data-product-card>
        <div class="product-image-wrapper">
          <a href="/product/<%= item.id %>"><img src="<%= item.colors[0].images[0] %>" alt="<%= item.name %>" loading="lazy" /></a>
          <button class="quick-view-trigger" type="button" data-quick-view data-product-id="<%= item.id %>" data-name="<%= item.name %>" data-price="<%= item.price.toFixed(2) %>" data-image="<%= item.colors[0].images[0] %>" data-color="<%= item.colors[0].name %>">Quick View</button>
        </div>
        <div class="product-info">
          <h3><a href="/product/<%= item.id %>"><%= item.name %></a></h3>
          <p class="price">N<%= item.price.toFixed(2) %></p>
        </div>
      </article>
      <% }) %>
    </div>
  </section>

  <section class="recently-viewed" data-recently-viewed data-reveal>
    <div class="section-header">
      <h2>Recently Viewed</h2>
      <p>Return to styles you explored earlier.</p>
    </div>
    <div class="recent-grid" data-recent-grid></div>
  </section>
</main>

<div class="sticky-add-to-cart" data-sticky-atc>
  <div>
    <strong><%= product.name %></strong>
    <span>N<%= product.price.toFixed(2) %></span>
  </div>
  <button type="button" class="button button-primary" data-sticky-submit>Add to Cart</button>
</div>

<div class="modal" id="sizeGuideModal" aria-hidden="true">
  <div class="modal-content glass-card">
    <button class="modal-close" type="button" data-close-size-guide>x</button>
    <h3>Size Guide</h3>
    <div class="sizes-list">
      <% product.sizes.forEach((size) => { %>
      <span class="size-item"><%= size.size %> - <%= size.dimensions %></span>
      <% }) %>
    </div>
  </div>
</div>

<a href="https://wa.me/2348000000000" class="floating-whatsapp-cta" target="_blank" rel="noreferrer" aria-label="Chat on WhatsApp">
  <img src="/assets/whatsapp-icon-free-png.webp" alt="WhatsApp" />
</a>

<script>
  window.PRODUCT_COLORS = <%- JSON.stringify(product.colors) %>;
  window.PRODUCT_VIEW = {
    id: <%= product.id %>,
    name: <%- JSON.stringify(product.name) %>,
    price: <%= product.price.toFixed(2) %>,
    image: <%- JSON.stringify(product.colors[0].images[0]) %>,
    color: <%- JSON.stringify(product.colors[0].name) %>
  };

  // Update stock status and add-to-cart button whenever the selected colour changes
  function updateStockForColor(colorIndex) {
    const colors = window.PRODUCT_COLORS;
    if (!colors || !colors[colorIndex]) return;
    const variant = colors[colorIndex];
    const qty = Number(variant.stock || 0);
    const threshold = Number(variant.lowStockThreshold || 3);

    let status;
    if (variant.availability && variant.availability === 'Out of Stock') {
      status = variant.availability;
    } else if (qty <= 0) {
      status = 'Out of Stock';
    } else if (qty < 5) {
      status = qty + ' unit' + (qty === 1 ? '' : 's') + ' left';
    } else {
      status = 'In Stock';
    }

    const stockEl = document.getElementById('stockStatus');
    const btnEl = document.getElementById('addToCartBtn');
    const stickyBtn = document.querySelector('[data-sticky-submit]');

    if (stockEl) {
      stockEl.textContent = status;
      stockEl.className = 'stock-info ' + (status === 'In Stock' ? 'stock-in-stock' : status === 'Out of Stock' ? 'stock-out-of-stock' : 'stock-low-stock');
    }

    const isOOS = qty <= 0;
    if (btnEl) {
      btnEl.disabled = isOOS;
      btnEl.textContent = isOOS ? 'Out of Stock' : 'Add to Cart';
    }
    if (stickyBtn) {
      stickyBtn.disabled = isOOS;
      stickyBtn.textContent = isOOS ? 'Out of Stock' : 'Add to Cart';
    }
  }

  // Attach to colour swatch clicks; main-ui.js may also fire these but we piggyback safely
  document.addEventListener('DOMContentLoaded', function () {
    // Initialize for the default (first) colour
    updateStockForColor(0);

    document.querySelectorAll('[data-color-index]').forEach(function (swatch) {
      swatch.addEventListener('click', function () {
        const idx = Number(this.getAttribute('data-color-index'));
        updateStockForColor(idx);
      });
    });
  });
</script>

<%- include('../partials/footer.ejs') %>
