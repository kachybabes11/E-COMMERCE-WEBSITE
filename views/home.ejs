<%- include('../partials/header.ejs') %>
<%- include('./partials/messages.ejs') %>

<main class="page-content luxury-home">
  <section class="hero-section" data-parallax>
    <div class="hero-copy" data-reveal>
      <span class="eyebrow">Chicnstraps 2026 Drop</span>
      <h1>Carry luxury with quiet confidence.</h1>
      <p>Discover statement bags that blend craftsmanship, structure, and elegance. Designed for women who want every detail to feel premium.</p>
      <div class="hero-actions">
        <a href="/products" class="button button-primary">Shop Collection</a>
        <a href="/wishlist" class="button button-secondary">View Wishlist</a>
      </div>
      <div class="hero-stats">
        <div><strong>5k+</strong><span>Happy clients</span></div>
        <div><strong>98%</strong><span>Repeat purchases</span></div>
        <div><strong>24h</strong><span>Fast dispatch</span></div>
      </div>
    </div>

    <div class="hero-carousel glass-card" data-reveal>
      <div class="carousel-container">
        <div class="carousel-slides" data-testimonial-carousel>
          <div class="carousel-slide active" style="background-image: url('../assets/thumbnails/thumbnail-5.jpeg');"><span class="slide-label">Executive Elegance</span></div>
          <div class="carousel-slide" style="background-image: url('../assets/thumbnails/thumbnail-9.jpeg');"><span class="slide-label">Clutch</span></div>
          <div class="carousel-slide" style="background-image: url('../assets/thumbnails/thumbnail-8.jpeg');"><span class="slide-label">After-Hours Mini Icons</span></div>
          <div class="carousel-slide" style="background-image: url('../assets/thumbnails/thumbnail-7.jpeg');"><span class="slide-label">After-Hours Mini Icons</span></div>
          <div class="carousel-slide" style="background-image: url('../assets/thumbnails/thumbnail-6.jpeg');"><span class="slide-label">After-Hours Mini Icons</span></div>
          <div class="carousel-slide" style="background-image: url('../assets/thumbnails/thumbnail-1.jpeg');"><span class="slide-label">After-Hours Mini Icons</span></div>
          <div class="carousel-slide" style="background-image: url('../assets/thumbnails/thumbnail-2.jpeg');"><span class="slide-label">After-Hours Mini Icons</span></div>
        </div>
        <button class="carousel-btn prev" type="button" data-carousel-prev><</button>
        <button class="carousel-btn next" type="button" data-carousel-next>></button>
        <div class="carousel-dots" data-carousel-dots></div>
      </div>
    </div>
  </section>

  <section class="bag-quote-section" data-reveal>
    <div class="bag-quote-media">
      <img src="/assets/portrait-stylish-young-woman-suit-260nw-2479904535.jpg" alt="Stylish woman carrying a premium bag" loading="lazy" />
      <div class="bag-quote-overlay">
        <p>"You can't buy happiness but you can buy a handbag and that's pretty close!"</p>
      </div>
    </div>
  </section>

  <section class="featured-section" data-reveal>
    <div class="section-header">
      <h2>Hot Picks</h2>
      <p>Editor-selected signatures from our most loved pieces.</p>
    </div>
    <div class="product-grid premium-grid">
      <% featured.forEach((product) => { %>
      <%
        const homeFirstAvailableVariant = product.colors.find(v => Number(v.stock || 0) > 0 && v.availability !== 'Out of Stock') || product.colors[0];
        const homeHasAnyStock = product.colors.some(v => Number(v.stock || 0) > 0 && v.availability !== 'Out of Stock');
        const homeStockLabel = homeHasAnyStock ? 'In Stock' : 'Out of Stock';
      %>
      <article class="product-card" data-product-card>
        <div class="product-image-wrapper">
          <img src="<%= homeFirstAvailableVariant.images[0] %>" alt="<%= product.name %>" loading="lazy" />
          <button class="wishlist-fab" type="button" data-product-id="<%= product.id %>" data-color="<%= homeFirstAvailableVariant.name %>" data-wishlist-toggle aria-label="Toggle wishlist">♡</button>
          <button class="quick-view-trigger" type="button" data-quick-view data-product-id="<%= product.id %>" data-name="<%= product.name %>" data-price="<%= product.price.toFixed(2) %>" data-image="<%= homeFirstAvailableVariant.images[0] %>" data-color="<%= homeFirstAvailableVariant.name %>">Quick View</button>
        </div>
        <div class="product-info">
          <h3><a href="/product/<%= product.id %>"><%= product.name %></a></h3>
          <p class="price">N<%= product.price.toFixed(2) %></p>
          <p class="stock-badge <%= homeStockLabel.toLowerCase().replace(/\s+/g, '-') %>"><%= homeStockLabel %></p>
          <div class="card-actions">
            <a href="/product/<%= product.id %>" class="button button-secondary">Details</a>
            <% if (homeHasAnyStock) { %>
            <form action="/cart/add" method="post" data-ajax-cart>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <input type="hidden" name="productId" value="<%= product.id %>" />
              <input type="hidden" name="color" value="<%= homeFirstAvailableVariant.name %>" />
              <input type="hidden" name="quantity" value="1" />
              <button type="submit" class="button button-primary">Add to Cart</button>
            </form>
            <% } else { %>
            <button type="button" class="button button-primary" disabled>Out of Stock</button>
            <% } %>
          </div>
        </div>
      </article>
      <% }) %>
    </div>
  </section>

  <section class="testimonials-section" data-reveal>
    <div class="section-header">
      <h2>Client Love</h2>
      <p>Real stories from women carrying Chicnstraps across cities.</p>
    </div>

    <div class="testimonial-track" data-review-carousel>
      <% testimonials.forEach((item) => { %>
      <article class="testimonial-card glass-card">
        <img src="<%= item.avatar %>" alt="<%= item.name %>" class="avatar" loading="lazy" />
        <h3><%= item.name %></h3>
        <small><%= item.role %></small>
        <p class="stars"><%= '*'.repeat(item.rating) %><%= '.'.repeat(5 - item.rating) %></p>
        <p>"<%= item.quote %>"</p>
      </article>
      <% }) %>
    </div>
  </section>

  <section class="about-section" data-reveal>
    <div class="section-header">
      <h2>Why Chicnstraps</h2>
      <p>A luxury shopping experience engineered for confidence.</p>
    </div>
    <div class="feature-grid">
      <div class="feature-card"><h3>Luxury Curation</h3><p>Every bag is handpicked for quality, silhouette, and finish.</p></div>
      <div class="feature-card"><h3>Secure Payments</h3><p>Protected checkout and trusted payment flow every time.</p></div>
      <div class="feature-card"><h3>Fast Delivery</h3><p>Nationwide shipping with transparent updates from order to doorstep.</p></div>
      <div class="feature-card"><h3>Personal Support</h3><p>Friendly concierge support for questions, sizing, and recommendations.</p></div>
    </div>
  </section>
</main>

<a href="https://wa.me/2348000000000" class="floating-whatsapp-cta" target="_blank" rel="noreferrer" aria-label="Chat on WhatsApp">
  <img src="/assets/whatsapp-icon-free-png.webp" alt="WhatsApp" />
</a>

<%- include('../partials/footer.ejs') %>
