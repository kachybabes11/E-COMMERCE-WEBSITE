<%- include('../partials/header.ejs') %>
<%- include('./partials/messages.ejs') %>

<main class="page-content info-page legal-page">
	<section class="glass-card info-card legal-hero" data-reveal>
		<div class="section-header legal-header">
			<h1>Privacy Policy</h1>
			<p>Your trust matters to us. This page explains what we collect, why we collect it, and how we protect it.</p>
		</div>

		<p>
			Welcome to Chic N Straps. Your privacy is important to us, and we are committed to protecting your personal
			information. By using our website, you agree to the practices described in this Privacy Policy.
		</p>
        <div class="legal-meta">
			<span>Last Updated: <%= new Date().toLocaleDateString() %></span>
		</div>
	</section>

	<section class="legal-layout" data-reveal>
		<aside class="glass-card legal-toc" aria-label="Privacy policy sections">
			<h2>Quick Navigation</h2>
			<a href="#information-collected">Information We Collect</a>
			<a href="#use-of-information">How We Use Information</a>
			<a href="#payments">Payment Processing</a>
			<a href="#google-signin">Google Sign-In</a>
			<a href="#cookies">Cookies</a>
			<a href="#sharing">Sharing Information</a>
			<a href="#security">Data Security</a>
			<a href="#retention">Data Retention</a>
			<a href="#rights">Your Rights</a>
			<a href="#third-party">Third-Party Services</a>
			<a href="#children">Children's Privacy</a>
			<a href="#changes">Policy Changes</a>
			<a href="#contact">Contact Us</a>
		</aside>

		<article class="glass-card info-card legal-content">
			<section id="information-collected" class="legal-section">
				<h2>1. Information We Collect</h2>
				<p>When you use our website, we may collect the following information:</p>

				<h3>1.1 Account Information</h3>
				<ul class="info-list">
					<li>Full name</li>
					<li>Email address</li>
					<li>Encrypted password</li>
				</ul>
				<p>You may also choose to sign in using your Google account through Google OAuth.</p>

				<h3>1.2 Order Information</h3>
				<ul class="info-list">
					<li>Full name</li>
					<li>Phone number</li>
					<li>Delivery address or pickup preference</li>
					<li>Products ordered</li>
					<li>Order history</li>
				</ul>

				<h3>1.3 Automatically Collected Information</h3>
				<ul class="info-list">
					<li>IP address</li>
					<li>Browser type</li>
					<li>Device information</li>
					<li>Pages visited</li>
					<li>Time spent on our website</li>
					<li>Cookies and similar technologies</li>
				</ul>
			</section>

			<section id="use-of-information" class="legal-section">
				<h2>2. How We Use Your Information</h2>
				<ul class="info-list">
					<li>Create and manage your account</li>
					<li>Process and fulfill your orders</li>
					<li>Arrange deliveries or pickups</li>
					<li>Send order confirmations and updates</li>
					<li>Respond to customer enquiries</li>
					<li>Improve our website and services</li>
					<li>Detect fraudulent or unauthorized activity</li>
					<li>Comply with legal obligations</li>
				</ul>
			</section>

			<section id="payments" class="legal-section">
				<h2>3. Payment Processing</h2>
				<p>
					All online payments are securely processed through Paystack. We do not collect, store, or have access to
					your debit or credit card details. Your payment information is handled directly by Paystack according to
					their privacy terms.
				</p>
			</section>

			<section id="google-signin" class="legal-section">
				<h2>4. Google Sign-In</h2>
				<p>If you sign in with Google, we may receive basic profile information such as:</p>
				<ul class="info-list">
					<li>Your name</li>
					<li>Your email address</li>
				</ul>
				<p>
					We only use this information to create or access your Chic N Straps account. We do not post to your Google
					account or access additional personal information without your permission.
				</p>
			</section>

			<section id="cookies" class="legal-section">
				<h2>5. Cookies</h2>
				<p>We use cookies to:</p>
				<ul class="info-list">
					<li>Keep you signed in</li>
					<li>Remember your shopping cart</li>
					<li>Save your preferences</li>
					<li>Improve website performance</li>
					<li>Enhance your shopping experience</li>
				</ul>
				<p>You can disable cookies in your browser settings, but some features may not function properly.</p>
			</section>

			<section id="sharing" class="legal-section">
				<h2>6. Sharing Your Information</h2>
				<p>We only share personal information when necessary to operate our services, including with:</p>
				<ul class="info-list">
					<li>Paystack for secure payment processing</li>
					<li>Google for Google Sign-In authentication</li>
					<li>Hosting and infrastructure providers</li>
					<li>Government or legal authorities where required by law</li>
				</ul>
				<p>We do not sell, rent, or trade your personal information to third parties.</p>
			</section>

			<section id="security" class="legal-section">
				<h2>7. Data Security</h2>
				<p>
					We use reasonable technical and organizational measures to protect your personal information from
					unauthorized access, loss, misuse, or disclosure. No method of internet transmission or electronic storage
					is completely secure.
				</p>
			</section>

			<section id="retention" class="legal-section">
				<h2>8. Data Retention</h2>
				<p>We keep personal information only as long as necessary to:</p>
				<ul class="info-list">
					<li>Maintain your account</li>
					<li>Process your orders</li>
					<li>Provide customer support</li>
					<li>Meet legal and regulatory requirements</li>
					<li>Resolve disputes</li>
				</ul>
				<p>When no longer required, your information is securely deleted or anonymized where appropriate.</p>
			</section>

			<section id="rights" class="legal-section">
				<h2>9. Your Rights</h2>
				<p>Depending on applicable laws, you may have the right to:</p>
				<ul class="info-list">
					<li>Access the personal information we hold about you</li>
					<li>Request correction of inaccurate information</li>
					<li>Request deletion of personal information</li>
					<li>Withdraw consent where applicable</li>
					<li>Request a copy of your personal data</li>
				</ul>
			</section>

			<section id="third-party" class="legal-section">
				<h2>10. Third-Party Services</h2>
				<p>Our website uses trusted third-party services, including:</p>
				<ul class="info-list">
					<li>Paystack for secure payment processing</li>
					<li>Google OAuth for optional account sign-in</li>
				</ul>
				<p>These providers operate under their own privacy policies.</p>
			</section>

			<section id="children" class="legal-section">
				<h2>11. Children's Privacy</h2>
				<p>
					Chic N Straps is not intended for children under 13. We do not knowingly collect personal information from
					children. If we learn we have collected such information without proper consent, we will take steps to
					delete it.
				</p>
			</section>

			<section id="changes" class="legal-section">
				<h2>12. Changes to This Privacy Policy</h2>
				<p>
					We may update this Privacy Policy from time to time to reflect service, operational, or legal changes. Any
					updates will be posted on this page with a revised Last Updated date.
				</p>
			</section>

			<section id="contact" class="legal-section legal-contact">
				<h2>13. Contact Us</h2>
				<p>If you have any questions about this policy or how we handle your data, contact us:</p>
				<p>
					Email: <a href="mailto:chicnstraps.ng@yahoo.com">chicnstraps.ng@yahoo.com</a><br>
					Phone: <a href="tel:+2347088069114">+234 708 806 9114</a>
				</p>
			</section>
		</article>
	</section>
</main>

<%- include('../partials/footer.ejs') %>
