<%- include('../partials/header.ejs') %>

<main class="page-content orders-page">
  <section class="orders-card">
    <h1>Your Orders</h1>
    <% if (!orders.length) { %>
      <div class="empty-state">
        <p>You haven't placed any orders yet.</p>
        <a href="/products" class="button button-secondary">Start shopping</a>
      </div>
    <% } else { %>
      <div class="orders-list">
        <% orders.forEach((order) => { %>
          <a class="order-row" href="/orders/<%= order.id %>">
            <div>
              <strong><%= order.order_number %></strong>
              <p><%= new Date(order.created_at).toLocaleDateString() %></p>
            </div>
            <div class="order-meta">
              <span class="order-status <%= order.order_status.toLowerCase() %>"><%= order.order_status %></span>
              <span>₦<%= formatCurrency(order.total_amount) %></span>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </section>
</main>

<%- include('../partials/footer.ejs') %>

<style>
.orders-page {
  padding: 3rem 1rem;
  background: #f6f7fb;
  min-height: 100vh;
}

.orders-card {
  max-width: 1040px;
  margin: auto;
  background: #fff;
  padding: 2rem;
  border-radius: 24px;
  box-shadow: 0 20px 40px rgba(0,0,0,0.08);
}

.orders-card h1 {
  margin-bottom: 1.5rem;
}

.orders-list {
  display: grid;
  gap: 1rem;
}

.order-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.25rem 1.5rem;
  border-radius: 18px;
  background: #f9fbff;
  color: inherit;
  text-decoration: none;
  transition: transform 0.2s ease;
}

.order-row:hover {
  transform: translateY(-2px);
}

.order-meta {
  display: flex;
  gap: 1rem;
  align-items: center;
}

.order-status {
  padding: 0.5rem 0.8rem;
  border-radius: 999px;
  font-size: 0.85rem;
  font-weight: 700;
  text-transform: uppercase;
}

.order-status.pending { background: #fff3cd; color: #986d04; }
.order-status.processing { background: #cfe2ff; color: #084298; }
.order-status.shipped { background: #d1e7dd; color: #0f5132; }
.order-status.delivered { background: #d1fccf; color: #1f6217; }
.order-status.cancelled { background: #f8d7da; color: #842029; }
</style>