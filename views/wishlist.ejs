<%- include('../partials/header.ejs') %>
<%- include('./partials/messages.ejs') %>

<main class="page-content wishlist-page">
  <section class="wishlist-card" data-reveal>
    <div class="section-header">
      <h1>Your Wishlist</h1>
      <p>Save your favorite pieces and move them into cart when ready.</p>
    </div>

    <% if (!wishlist.length) { %>
    <div class="empty-state premium-empty">
      <div class="empty-illustration">o</div>
      <h2>Your wishlist is waiting.</h2>
      <p>Discover signature styles and save the ones that match your vibe.</p>
      <a href="/products" class="button button-primary">Discover Bags</a>
    </div>
    <% } else { %>
    <div class="wishlist-grid">
      <% wishlist.forEach((item) => { %>
      <article class="wishlist-item glass-card" data-reveal>
        <img src="<%= item.image %>" alt="<%= item.product_name %>" loading="lazy" />
        <div class="wishlist-copy">
          <h3><a href="/product/<%= item.product_id %>"><%= item.product_name %></a></h3>
          <p>Color: <strong><%= item.color %></strong></p>
          <p class="price">N<%= formatCurrency(item.price) %></p>
          <div class="wishlist-actions">
            <a href="/product/<%= item.product_id %>" class="button button-secondary">View</a>

            <form action="/wishlist/move-to-cart" method="post">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <input type="hidden" name="productId" value="<%= item.product_id %>" />
              <input type="hidden" name="color" value="<%= item.color %>" />
              <button type="submit" class="button button-primary">Move to Cart</button>
            </form>

            <form action="/wishlist/remove" method="post" data-wishlist-remove>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <input type="hidden" name="productId" value="<%= item.product_id %>" />
              <input type="hidden" name="color" value="<%= item.color %>" />
              <button type="submit" class="button button-link">Remove</button>
            </form>
          </div>
        </div>
      </article>
      <% }) %>
    </div>
    <% } %>
  </section>
</main>

<a href="/products" class="floating-shop-cta" aria-label="Shop now">Shop Now</a>

<%- include('../partials/footer.ejs') %>
