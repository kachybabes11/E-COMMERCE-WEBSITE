<%- include('../partials/header.ejs') %>

<main class="page-content admin-orders-page">
  <section class="admin-orders-card">
    <div class="admin-header">
      <h1>Order Management</h1>
      <form class="admin-actions" method="get" action="/admin/orders">
        <input type="text" name="search" placeholder="Search orders" value="<%= search || '' %>" />
        <select name="status">
          <option value="">All statuses</option>
          <% ['Pending','Processing','Shipped','Delivered','Cancelled'].forEach((statusOption) => { %>
            <option value="<%= statusOption %>" <%= status === statusOption ? 'selected' : '' %>><%= statusOption %></option>
          <% }) %>
        </select>
        <button class="button button-primary" type="submit">Filter</button>
      </form>
    </div>

    <% if (!orders.length) { %>
      <div class="empty-state">
        <p>No orders found.</p>
      </div>
    <% } else { %>
      <div class="orders-table">
        <% orders.forEach((order) => { %>
          <a class="order-row" href="/admin/orders/<%= order.id %>">
            <div><strong><%= order.order_number %></strong></div>
            <div><%= new Date(order.created_at).toLocaleDateString() %></div>
            <div><%= order.customer_name %></div>
            <div>₦<%= formatCurrency(order.total_amount) %></div>
            <div><span class="order-status <%= order.order_status.toLowerCase() %>"><%= order.order_status %></span></div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </section>
</main>

<%- include('../partials/footer.ejs') %>

<style>
.admin-orders-page {
  padding: 3rem 1rem;
  background: var(--bg);
  color: var(--text);
}

.admin-orders-card {
  max-width: 1200px;
  margin: auto;
  background: var(--surface);
  padding: 2rem;
  border-radius: 24px;
  border: 1px solid var(--surface-border);
  box-shadow: var(--shadow-lg);
  backdrop-filter: blur(10px);
}

.admin-header {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
  align-items: center;
}

.admin-actions {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.admin-actions input,
.admin-actions select {
  padding: 0.9rem 1rem;
  border-radius: 12px;
  border: 1px solid color-mix(in srgb, var(--surface-border) 72%, #cfc2af 28%);
  background: var(--surface-strong);
  color: var(--text);
}

.orders-table {
  display: grid;
  gap: 0.75rem;
  margin-top: 1.5rem;
}

.order-row {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1.3fr 1fr 1fr;
  padding: 1rem 1.2rem;
  background: var(--surface-strong);
  border: 1px solid var(--surface-border);
  border-radius: 16px;
  text-decoration: none;
  color: inherit;
}

.order-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.4rem 0.7rem;
  border-radius: 999px;
  font-weight: 700;
}

.order-status.pending { background: color-mix(in srgb, #c79b3b 18%, var(--surface-strong)); color: #8a6420; }
.order-status.processing { background: color-mix(in srgb, #4a86d4 18%, var(--surface-strong)); color: #295a96; }
.order-status.shipped { background: color-mix(in srgb, #5f9c72 18%, var(--surface-strong)); color: #356245; }
.order-status.delivered { background: color-mix(in srgb, #79a85c 18%, var(--surface-strong)); color: #4a7135; }
.order-status.cancelled { background: color-mix(in srgb, #d67272 18%, var(--surface-strong)); color: #8d3c3c; }
</style>