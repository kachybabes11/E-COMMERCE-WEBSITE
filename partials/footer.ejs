  <style>
    .site-footer {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #eaeaea;
  padding: 70px 20px 25px;
  font-family: "Montserrat", sans-serif;
}

/* MAIN GRID */
.footer-container {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 40px;
  max-width: 1200px;
  margin: auto;
}

/* LOGO + BRAND TEXT */
.footer-logo {
  font-size: 28px;
  font-weight: 700;
  letter-spacing: 1px;
  margin-bottom: 15px;
  color: #ffffff;
}

.footer-section p {
  color: #ffffff;
  line-height: 1.6;
  font-size: 14px;
}

/* HEADINGS */
.footer-section h3 {
  font-size: 16px;
  margin-bottom: 15px;
  color: #ffffff;
  position: relative;
}

/* subtle underline effect */
.footer-section h3::after {
  content: "";
  width: 35px;
  height: 2px;
  background: #f5ba13;
  position: absolute;
  left: 0;
  bottom: -6px;
}

/* LINKS */
.footer-section a {
  display: block;
  color: #ffffff;
  text-decoration: none;
  margin: 8px 0;
  font-size: 14px;
  transition: 0.3s ease;
}

.footer-section a:hover {
  color: #f5ba13;
  transform: translateX(5px);
}

/* SOCIAL LINKS */
.socials {
  margin-top: 12px;
  
}

.socials img{
  width: 30px;
  height: 30px;
  object-fit: cover;
}

.socials a {
  display: inline-block;
  margin-right: 10px;
  font-size: 13px;
  background: white;
  padding: 6px 10px;
  border: 1px solid;
  border-radius: 20px;
  transition: 0.3s ease;
}

.socials a:hover {
  background: #f5ba13;
  color: #000;
  border-color: #f5ba13;
}

/* NEWSLETTER */
.newsletter-form {
  display: flex;
  margin-top: 12px;
  gap: 10px;
}

.newsletter-form input {
  flex: 1;
  padding: 10px;
  border-radius: 6px;
  border: none;
  outline: none;
  background: #ffffff;
  color: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.newsletter-form input::placeholder {
  color: #777;
}

.newsletter-form button {
  padding: 10px 15px;
  border: none;
  background: #f5ba13;
  color: #000;
  font-weight: bold;
  cursor: pointer;
  border-radius: 6px;
  transition: 0.3s ease;
}

.newsletter-form button:hover {
  background: #ffcc33;
  transform: scale(1.05);
}

/* BOTTOM BAR */
.footer-bottom {
  border-top: 1px solid #222;
  margin-top: 50px;
  padding-top: 20px;
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  font-size: 13px;
  color: #888;
}

.footer-bottom a {
  color: #f5ba13;
  text-decoration: none;
  transition: 0.3s ease;
}

.footer-bottom a:hover {
  color: #ffcc33;
}
  </style>
</footer>
  </body>
